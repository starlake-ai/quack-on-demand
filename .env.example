# Copy to `.env`, edit, then `./scripts/docker/run-docker-compose.sh`.
#
# IMPORTANT: docker compose's .env parser does NOT support inline
# comments - anything after `KEY=` to end-of-line is taken as the value.
# Keep comments on their OWN lines (like this one), never on the same
# line as a KEY=VALUE pair.
#
# The same applies to a literal `#` INSIDE a value, not just after one:
# scripts/docker/run-docker-compose.sh's own .env reader truncates a value at its
# first `#` too. Do not use `#` in PG_PASSWORD, ADMIN_PASSWORD, or any
# QOD_S3_*_KEY value below.

# ----- Postgres metastore (the docker-compose Postgres service) -----
#
# PG_DBNAME is the CONTROL-PLANE database. Liquibase creates the
# `qodstate_*` tables here (tenants, tenant-dbs, pools, nodes, users,
# RBAC graph). Each managed tenant-db is a SEPARATE Postgres database
# next to it, named `${tenant}_${tenantDb}` (default `tpch_tpch1`) and
# auto-provisioned by the manager via DbAdmin; that's where DuckLake's
# `__ducklake_*` catalog and the parquet metadata live. Don't reuse
# this name for tenant data.
PG_USER=postgres
PG_PASSWORD=azizam
PG_DBNAME=qod
PG_SCHEMA=main

# Host-exposed port for the in-compose Postgres. Bump if the host
# already runs Postgres on 5432 - the internal container port stays
# 5432, the manager talks to it via the service name `postgres` on the
# compose network, so only external psql/DBeaver access is affected.
# scripts/docker/run-docker-compose.sh auto-bumps this to 15432 if it
# detects the host port is busy.
PG_PORT=15432

# ----- External data folders (host bind-mount overrides) -----
#
# Every persistent-state mount defaults to a repo-relative folder. Set any
# of these to an EXTERNAL path (absolute, e.g. /data/qod/pgdata, or relative)
# to keep the data off the repo - on a dedicated disk, an NFS mount, etc.
# Leave them unset/commented to use the repo-relative defaults.
#
# NOTE: `NUKE=1 ./scripts/docker/run-docker-compose.sh` only wipes the repo-relative
# defaults (./pgdata, ./ducklake, ./certs, ./seaweedfs, ./seaweedfs-config,
# ./starflow).
# External folders you point these at are NOT auto-wiped - remove them by hand.
#
#PGDATA_DIR=./pgdata
# The prep step run-docker-compose.sh runs on every invocation hardcodes
# the defaults (./ducklake, ./certs, chowned to uid 1000). Pointing either
# of these at a non-default path means chowning it to 1000:1000 yourself.
#DUCKLAKE_DIR=./ducklake
#CERTS_DIR=./certs
# Only used with the `seaweedfs` profile. The prep step also hardcodes the
# defaults (./seaweedfs, ./seaweedfs-config - no chown needed, the seaweedfs
# image runs as root in-container); pointing these at a non-default path
# is fine: Docker auto-creates missing bind-mount paths root-owned, and seaweedfs runs as root in-container, so no manual preparation is needed.
#SEAWEEDFS_DIR=./seaweedfs
#SEAWEEDFS_CONFIG_DIR=./seaweedfs-config

# ----- Quack-on-demand auth + TLS -----
#
# AUTH gates BOTH the FlightSQL edge AND the admin UI / REST API:
#   true  → DB-backed auth, admin user seeded from ADMIN_USERNAME /
#           ADMIN_PASSWORD, UI login works with those credentials.
#           QOD_ADMIN_USERNAME / QOD_ADMIN_PASSWORD (in the environment or
#           here) are accepted too and win over these short names. Seeded on
#           the FIRST boot only: changing them later does not rotate the
#           password (use `qod auth change-password`).
#   false → no password login: nobody can sign in unless system-scope
#           OIDC sign-in (QOD_MGMT_OIDC_ISSUER_URL) is configured, which
#           docker-compose.yml does not pass (add it in a
#           docker-compose.override.yml).
# Default ON because that's what the demo UI flow expects.
AUTH=true

# Seeded into qodstate_user (as a superuser: tenant IS NULL) when
# AUTH=true. ROTATE the password before exposing the edge beyond
# localhost.
ADMIN_USERNAME=admin@localhost.local,admin
ADMIN_PASSWORD=admin

# No static REST API key is passed to the manager: people log in (`qod login`,
# the UI) and automation uses a personal access token (`qod auth pat create`,
# minted from a session) sent as X-API-Key. An API_KEY line left in .env by an
# earlier release is no longer read.

# `true` enables FlightSQL edge TLS (cert auto-generated under ./certs).
# When `true`, the tpch-load-test's --url must be grpc+tls://… ; when `false`,
# use grpc://… instead.
TLS=true

# ----- Host ports -----
#
# Only two ports are part of the public contract and need to be reachable
# by users / BI tools:
#   MANAGER_PORT (20900) - Manager REST API + React admin UI
#   EDGE_PORT    (31338) - Arrow Flight SQL edge (TLS on by default)
#
# QUACK_MIN_PORT..QUACK_MAX_PORT (21900-22500) are the internal Quack node
# child processes. They are published here only because docker-compose runs
# the nodes as child processes inside the manager container and the manager
# reaches them over localhost. Clients never connect to them; in Kubernetes
# the nodes are separate pods and this range is not exposed at all. Do NOT
# open this range on a public firewall.
MANAGER_PORT=20900
EDGE_PORT=31338
QUACK_MIN_PORT=21900
QUACK_MAX_PORT=22500

# ----- Optional: Starflow (Starlake API + UI) next to the manager -----
#
# The `starflow` compose profile, the compose twin of
# `qod start --with-starflow`: Starflow on STARFLOW_PORT, its metadata in a
# STARFLOW_DB database on the same Postgres, SSO from the QoD UI (Workbench).
# STARFLOW_ENABLED=true turns it on, both for `docker compose` (with
# COMPOSE_PROFILES=starflow or --profile starflow) and for
# ./scripts/docker/run-docker-compose.sh (which activates the profile itself).
#STARFLOW_ENABLED=true
#COMPOSE_PROFILES=starflow
#
# Starflow needs SESSION_JWT_SECRET, stable across restarts: QoD and
# Starflow sign SSO tokens with it, and Starflow calls QoD with the signed-in
# user's own session. run-docker-compose.sh generates it into .env when
# missing; with plain `docker compose`, set it yourself:
#   SESSION_JWT_SECRET=$(openssl rand -hex 48)
# A pinned SESSION_JWT_SECRET also keeps QoD UI sessions alive across
# restarts, with or without Starflow.
#SESSION_JWT_SECRET=
#
# Starflow release baked into the locally built image (docker/starflow).
#STARFLOW_VERSION=1.8.8
# Host port of the Starflow UI.
#STARFLOW_PORT=9900
# Browser-facing URLs, for clients on other machines. STARFLOW_DOMAIN is
# the host part of STARFLOW_URL (session cookie domain).
#STARFLOW_URL=http://localhost:9900
#STARFLOW_DOMAIN=localhost
#QOD_PUBLIC_URL=http://localhost:20900
# Host dir for Starflow projects + DAGs, and its metadata database.
#STARFLOW_DIR=./starflow
#STARFLOW_DB=starlake
# Edge URL Starflow queries through. Compose defaults to
# http://quack:31338 (TLS=false); with TLS=true use https.
# run-docker-compose.sh derives it from TLS when unset.
#STARFLOW_QOD_FLIGHT_URL=https://quack:31338

# ----- Optional one-shot TPCH loader -----
#
# Generates TPCH data into the bootstrap tenant-db (`tpch_tpch1` by
# default) via DuckDB's dbgen() table function.
# Driven by run-docker-compose.sh:
#   LOAD_TPCH=1 ./scripts/docker/run-docker-compose.sh
# Or against a running stack:
#   docker compose exec quack /app/scripts/load-tpch-dbgen.sh
#
# TPCH_SF=1 generates ~6M lineitem rows; SF=10 is ~60M.
# TPCH_SCHEMA is the DuckLake schema inside the tenant-db; MUST differ
# from the tenant-db's name.
TPCH_SF=1
TPCH_SCHEMA=tpch1

# ----- Optional: DuckLake on S3-compatible object storage -----
#
# Out of the box DuckLake writes parquet under ./ducklake (host bind-mount).
# To switch to an S3-compatible bucket - SeaweedFS, MinIO, AWS S3, R2, GCS
# via the HMAC/S3-interop endpoint - set QOD_DUCKLAKE_DATA_PATH to an
# s3:// URL and fill in the QOD_S3_* credentials below. spawn-quack-node.sh
# and load-tpch-dbgen.sh detect the scheme, install httpfs, and CREATE SECRET
# so every Quack node reads/writes parquet against the bucket.
#
# There is no separate "seed" credential: run-docker-compose.sh's LOAD_TPCH/
# LOAD_TPCDS/LOAD_SSB demo seeders read these SAME QOD_S3_* vars to write
# through the identical DuckDB SECRET the manager uses. The quack/quackquack
# defaults below only work against the bundled seaweedfs profile - pointing
# at an external store (Option B) means setting real credentials here once,
# which then covers both the manager AND the seed; mismatched or missing
# ones leave the seeded parquet unreadable by the manager (or vice versa).
#
# ---- Option A: SeaweedFS in compose (zero external dependencies) ----
# Bring up the bundled SeaweedFS with:
#   docker compose --profile seaweedfs up -d
# then uncomment the four lines below. seaweedfs:8333 resolves on the
# compose network; the matching service is in docker-compose.yml.
#
#QOD_DUCKLAKE_DATA_PATH=s3://ducklake/tpch
#QOD_S3_ENDPOINT=seaweedfs:8333
#QOD_S3_ACCESS_KEY_ID=quack
#QOD_S3_SECRET_ACCESS_KEY=quackquack
#QOD_S3_REGION=us-east-1
#QOD_S3_USE_SSL=false
#QOD_S3_URL_STYLE=path
#S3_BUCKET=ducklake
#
# ---- Option B: External AWS S3 (or any S3-compatible endpoint) ----
# Leave the seaweedfs profile off; just set the bucket + credentials.
# Omit QOD_S3_ENDPOINT to use the AWS default (s3.amazonaws.com).
#
#QOD_DUCKLAKE_DATA_PATH=s3://my-bucket/quack/tpch
#QOD_S3_ACCESS_KEY_ID=AKIA...
#QOD_S3_SECRET_ACCESS_KEY=...
#QOD_S3_REGION=us-east-1
#QOD_S3_USE_SSL=true
#QOD_S3_URL_STYLE=vhost

# ----- Optional corporate proxy -----
#
# Set these when the host needs an HTTP proxy to reach the public
# internet (extensions.duckdb.org for DuckDB's `INSTALL quack` /
# `INSTALL tpch` / etc.). compose forwards them into the container,
# the manager translates HTTP_PROXY into DuckDB's `SET http_proxy`
# before INSTALL, and spawn-quack-node.sh does the same for child
# Quack nodes. Leave blank on non-proxied networks.
#
# Note: `docker pull` itself reads the daemon's proxy config, NOT
# these vars - configure ~/.docker/config.json or systemd unit
# overrides if `docker compose pull` also needs to traverse the proxy.
#HTTP_PROXY=http://proxy.corp.example:3128
#HTTPS_PROXY=http://proxy.corp.example:3128
#NO_PROXY=localhost,127.0.0.1,postgres,.corp.example

# ----- Release announcements (maintainers only) -----
#
# Discord webhook for the #news channel. release-jar.sh calls
# scripts/release/announce-release-discord.sh after creating the GitHub release;
# it posts the repo link plus the version's CHANGELOG.md section. The
# webhook URL is a credential - keep it in the untracked .env, never here.
#QOD_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ----- Optional: fleet mode (docker-compose.fleet.yml) -----
# Shared join token every fleet server presents. Required by the fleet override:
#   docker compose -f docker-compose.yml -f docker-compose.fleet.yml --profile seaweedfs up -d --build
# Generate with: openssl rand -hex 24
#FLEET_JOIN_TOKEN=
