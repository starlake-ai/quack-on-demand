# /etc/qod/manager.env: the manager's own settings, read by qod-manager.service.
# install -m 0600 -o root -g root manager.env.example /etc/qod/manager.env, then edit.
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`.
# A value here is a real environment variable, so it wins over one `qod setup` stored.

# The control-plane Postgres. It must be reachable; qod start creates the database when it is
# missing and psql is installed.
QOD_PG_HOST=localhost
QOD_PG_PORT=5432
QOD_PG_USER=qod
QOD_PG_PASSWORD=change-me
QOD_PG_DBNAME=qod

# First boot only: the admin password the manager seeds. A service has no terminal to ask on,
# so the first start refuses without it. Remove the line after the first boot (later boots
# never read it).
#QOD_ADMIN_PASSWORD=

# Where DuckLake data goes (default: the qod user's data folder, ~/.local/share/qod).
#QOD_DUCKLAKE_DATA_PATH=/var/lib/qod/ducklake/data

# Read by install.sh too, as they change what a start downloads or where it looks:
#JAVA_HOME=/usr/lib/jvm/temurin-25
#HTTPS_PROXY=http://proxy.internal:3128
